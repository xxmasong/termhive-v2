# /etc/termhive/cloud.env — root 0600. Read by termhive-cloud.service and
# termhive-admin.

ADMIN_EMAILS=xxmasong@gmail.com
# open | invite
SIGNUP_MODE=open
CLOUD_ORIGINS=https://sg1-termhive2.tailfa2e0b.ts.net

# Firebase web app config (Project settings → Your apps → Web app).
# Leave empty until the project exists; /auth/config then says not configured.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Smoke tests only: lets `termhive-admin dev-session` mint sessions. Keep 0.
TERMHIVE_DEV_SESSIONS=0

[Unit]
Description=TermHive workspace for %i
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/termhive/ws/%i.env
WorkingDirectory=/opt/termhive-v2
ExecStart=/usr/local/bin/npm run start:all
Restart=always
RestartSec=5

# ── Sandbox ───────────────────────────────────────────────────────────────
# Agents run arbitrary code, so each workspace is confined. Every directive
# below was verified inside the unprivileged LXC (CT102), with node-pty and the
# claude/codex/gemini CLIs still working. No hardware isolation is available
# here (nested VPS, no /dev/kvm), so this is defence in depth on a shared kernel.
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RemoveIPC=yes
# Filesystem: the OS is read-only, other homes are invisible, own home is
# writable, /tmp and /var/tmp are private.
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/%i
PrivateTmp=yes
PrivateDevices=yes
# Other users' processes are invisible (hidepid without remounting /proc).
# ProcSubset=pid is left off: Node and the CLIs read /proc/meminfo etc.
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Namespaces stay allowed: agent CLIs may sandbox their own tools (bwrap).
# Safety caps, not plan limits: one runaway workspace must not take the host
# down (fork bombs, memory leaks). Plans limit projects/agents only.
TasksMax=1024
MemoryMax=75%

[Install]
WantedBy=multi-user.target

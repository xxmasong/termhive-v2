[Unit]
Description=TermHive workspace for %i
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/termhive/ws/%i.env
WorkingDirectory=/opt/termhive-v2
ExecStart=/usr/local/bin/npm run start:all
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

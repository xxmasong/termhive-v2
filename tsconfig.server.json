{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/workspace-limits.ts",
    "src/routes.ts",
    "src/services/**/*.ts",
    "src/graphql/**/*.ts",
    "src/cloud/**/*.ts",
    "tests/**/*.ts"
  ]
}

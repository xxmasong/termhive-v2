{
  "name": "termhive-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite --config client/vite.config.ts --host 0.0.0.0",
    "dev:server": "tsup --watch --onSuccess \"node dist/server.js\"",
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsup",
    "daemon": "node dist/daemon/daemon.js",
    "start": "node dist/server.js",
    "start:all": "concurrently -n daemon,web \"npm run daemon\" \"npm run start\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client --max-warnings=0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.0.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.15",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recoil": "^0.7.7",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
